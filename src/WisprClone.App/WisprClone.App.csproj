<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms intentionally NOT enabled: we use Win32 P/Invoke for
         the monitor work directly, and turning WinForms on pollutes the
         global namespace with WinForms types that collide with WPF
         (Clipboard, Application, Timer, Color all become ambiguous). -->
    <RootNamespace>WisprClone.App</RootNamespace>
    <AssemblyName>WisprClone</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
    <FileVersion>0.3.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <!-- Local Whisper / OpenVINO removed: pivoted to OpenAI Whisper API for
         1-3s latency on any hardware. Audio is POSTed as multipart form-data
         via System.Net.Http (in-box). No NuGet dependency required. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the .ico as a regular file too so the tray manager can load
         it directly from the install directory instead of regenerating. -->
    <Content Include="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
