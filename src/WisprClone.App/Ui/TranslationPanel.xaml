<Window x:Class="WisprClone.App.Ui.TranslationPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WisprClone Translate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        KeyDown="OnAnyKeyDown">
    <Border CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Padding="20,16"
            Width="520">
        <Border.Background>
            <SolidColorBrush Color="#1A1A1A" Opacity="0.95"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <StackPanel>

            <!-- Header row: title + direction + close -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Translation" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DirectionText" Text="…" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Click="OnClose_Click" Style="{DynamicResource ChipStyle}"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- Original -->
            <TextBlock Text="Original" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="#11FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="OriginalText" Foreground="#DDD" FontSize="13" TextWrapping="Wrap" MaxHeight="100"/>
            </Border>

            <!-- Translation -->
            <TextBlock Text="Translation" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="#22FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="TranslatedText" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxHeight="160"/>
            </Border>

            <!-- Status (busy / error) -->
            <TextBlock x:Name="StatusText"
                       Foreground="#FFC044" FontSize="12" Margin="0,0,0,12"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="KeepBtn"
                        Content="Keep original  (Esc)"
                        Style="{DynamicResource ChipStyle}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="OnKeep_Click"/>
                <Button x:Name="UseBtn"
                        Content="Use translation  (Enter)"
                        Style="{DynamicResource ChipPrimaryStyle}"
                        Padding="16,8"
                        IsEnabled="False"
                        Click="OnUse_Click"/>
            </StackPanel>
        </StackPanel>

        <Border.Resources>
            <!-- Subtle chip-style button (neutral) -->
            <Style x:Key="ChipStyle" TargetType="Button">
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary action button (filled blue) -->
            <Style x:Key="ChipPrimaryStyle" TargetType="Button" BasedOn="{StaticResource ChipStyle}">
                <Setter Property="Background" Value="#2B6CB0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A7EC8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1F5790"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
    </Border>
</Window>
