<Window x:Class="WisprClone.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WisprClone Settings"
        Width="560" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFAFAFA"
        FontFamily="Segoe UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="WisprClone Settings" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Changes apply immediately when you click Save."
                       FontSize="12" Foreground="#888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Body -->
        <StackPanel Grid.Row="1">

            <!-- API Key -->
            <TextBlock Text="OpenAI API key" FontWeight="SemiBold" FontSize="13"/>
            <PasswordBox x:Name="ApiKeyBox"
                         Margin="0,6,0,4"
                         Padding="8,6"
                         FontFamily="Consolas"
                         FontSize="12"/>
            <TextBlock FontSize="11" Foreground="#888" Margin="0,0,0,20" TextWrapping="Wrap">
                Used for transcription. Stored in plain text in your settings.json.
                <Hyperlink NavigateUri="https://platform.openai.com/api-keys"
                           RequestNavigate="OnHyperlink_RequestNavigate">Get / manage keys at OpenAI →</Hyperlink>
            </TextBlock>

            <!-- Hotkey key -->
            <TextBlock Text="Hotkey" FontWeight="SemiBold" FontSize="13"/>
            <ComboBox x:Name="HotkeyKeyCombo"
                      Margin="0,6,0,4"
                      Padding="8,6"
                      FontSize="13">
                <ComboBoxItem Content="Ctrl + Win  —  the default (no third key)" Tag="Ctrl+Win"/>
                <ComboBoxItem Content="Right Alt  —  single key, comfortable for thumb" Tag="Right Alt"/>
                <ComboBoxItem Content="F8" Tag="F8"/>
                <ComboBoxItem Content="F9" Tag="F9"/>
            </ComboBox>
            <TextBlock FontSize="11" Foreground="#888" Margin="0,0,0,16" TextWrapping="Wrap">
                Hotkey changes take effect after restarting WisprClone.
            </TextBlock>

            <!-- Hotkey mode -->
            <TextBlock Text="Hotkey behaviour" FontWeight="SemiBold" FontSize="13"/>
            <ComboBox x:Name="HotkeyCombo"
                      Margin="0,6,0,4"
                      Padding="8,6"
                      FontSize="13">
                <ComboBoxItem Content="Push-to-talk  —  hold to record" Tag="PushToTalk"/>
                <ComboBoxItem Content="Toggle  —  tap once on / once off" Tag="Toggle"/>
            </ComboBox>
            <TextBlock FontSize="11" Foreground="#888" Margin="0,0,0,20" TextWrapping="Wrap">
                Push-to-talk works well for short clips; Toggle for longer dictation.
            </TextBlock>

            <!-- Max recording length -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Max recording length"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>

                <Slider x:Name="MaxSlider"
                        Grid.Row="1" Grid.Column="0"
                        Minimum="10" Maximum="600"
                        Value="120"
                        IsSnapToTickEnabled="True"
                        TickFrequency="10"
                        VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding ElementName=MaxSlider, Path=Value, StringFormat={}{0:F0}s, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         TextAlignment="Center"
                         Padding="6,4"
                         Margin="12,0,0,0"/>
            </Grid>

            <!-- Refinement -->
            <CheckBox x:Name="OfferRefinementCheck"
                      Content="Offer to refine dictations (Professional / Casual / Shorter / Longer)"
                      FontSize="13" Margin="0,4,0,4"/>
            <TextBlock FontSize="11" Foreground="#888" Margin="0,0,0,12" TextWrapping="Wrap">
                After each transcription, a small panel pops up offering AI rewrites via OpenAI.
                Each refinement costs ≈ $0.0001 (gpt-4o-mini). Panel auto-dismisses after 8&#xa0;s.
            </TextBlock>

            <!-- Keep WAVs -->
            <CheckBox x:Name="KeepWavsCheck"
                      Content="Keep WAV recordings on disk after transcription"
                      FontSize="13" Margin="0,4,0,4"/>
            <TextBlock FontSize="11" Foreground="#888" Margin="0,0,0,16" TextWrapping="Wrap">
                Off (default): deletes the WAV right after a successful transcription. Avoids filling
                the disk. Files older than 7&#xa0;days are also pruned automatically at app start.
            </TextBlock>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Foreground="#D9534F"
                       FontSize="12"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="92" Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel_Click"/>
            <Button Content="Save"
                    Width="92" Height="32"
                    IsDefault="True"
                    Click="OnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
