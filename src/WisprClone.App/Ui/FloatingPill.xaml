<Window x:Class="WisprClone.App.Ui.FloatingPill"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Title="WisprClone">
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Padding="14,8">
        <Border.Background>
            <SolidColorBrush Color="#1A1A1A" Opacity="0.85"/>
        </Border.Background>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Indicator"
                     Width="10" Height="10"
                     Margin="0,0,8,0"
                     Fill="#FF4444"/>
            <TextBlock x:Name="StatusText"
                       Text="Recording"
                       Foreground="White"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
